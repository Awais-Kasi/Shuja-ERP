APP_NAME="Shuja ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
# Production: APP_ENV=production, APP_DEBUG=false, and serve over HTTPS.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=shuja_erp
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): set SESSION_SECURE_COOKIE=true.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — 'log' writes messages to the log in dev. Configure real SMTP for production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@shuja.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Shuja ERP ---------------------------------------------------------------
# Seeding: demo data (sample transactions, stock, FX rates) is seeded automatically
# except in production. Force it on/off explicitly with SEED_DEMO.
# SEED_DEMO=false
# First admin created by the seeder. In production set a strong password here, or one
# is generated and printed once during `php artisan db:seed`.
SEED_ADMIN_EMAIL=admin@shuja.test
# SEED_ADMIN_PASSWORD=
# SEED_ACCOUNTANT_PASSWORD=
# Absolute path to pg_dump if it is not on PATH (used by `php artisan backup:database`).
# PG_DUMP_PATH="C:/laragon/bin/postgresql/pgsql/bin/pg_dump.exe"
